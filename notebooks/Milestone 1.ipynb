 490\nC    459\nA    369\nD    358\nE    324\nName: count, dtype: int64\nMost frequent: 490 Least frequent: 324\nSum: 814\n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# Q2: Vocabulary size after cleaning\ndef clean_text(text):\n    text = text.lower()\n    text = text.translate(str.maketrans('', '', string.punctuation))\n    return text\n\ndf['clean_prompt'] = df['prompt'].apply(clean_text)\nall_words = ' '.join(df['clean_prompt']).split()\nvocab = set(all_words)\nprint(\"Vocabulary size:\", len(vocab))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:02.765440Z","iopub.execute_input":"2026-07-16T06:21:02.765765Z","iopub.status.idle":"2026-07-16T06:21:02.784637Z","shell.execute_reply.started":"2026-07-16T06:21:02.765742Z","shell.execute_reply":"2026-07-16T06:21:02.783411Z"}},"outputs":[{"name":"stdout","text":"Vocabulary size: 859\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"# Q3: Words left in Row ID 1 after removing stop words\nrow1 = df[df['id'] == 1]['clean_prompt'].values[0]\nwords = row1.split()\nfiltered = [w for w in words if w not in ENGLISH_STOP_WORDS]\nprint(\"Words in Row ID 1 after stop word removal:\", len(filtered))\nprint(filtered)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:05.125855Z","iopub.execute_input":"2026-07-16T06:21:05.126241Z","iopub.status.idle":"2026-07-16T06:21:05.137855Z","shell.execute_reply.started":"2026-07-16T06:21:05.126209Z","shell.execute_reply":"2026-07-16T06:21:05.136788Z"}},"outputs":[{"name":"stdout","text":"Words in Row ID 1 after stop word removal: 13\n['pick', 'best', 'possible', 'answer', 'martin', 'heideggers', 'view', 'relationship', 'time', 'human', 'existence', 'listed', 'options']\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# Q4: TF-IDF vectorizer on prompts + all options\noptions = ['A', 'B', 'C', 'D', 'E']\n\ndef get_combined_texts(df):\n    texts = []\n    for _, row in df.iterrows():\n        texts.append(str(row['prompt']))\n        for opt in options:\n            texts.append(str(row[opt]))\n    return texts\n\nall_texts = get_combined_texts(df)\nvectorizer = TfidfVectorizer(stop_words='english')\nvectorizer.fit(all_texts)\nprint(\"Vocabulary size (TF-IDF):\", len(vectorizer.vocabulary_))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:08.327647Z","iopub.execute_input":"2026-07-16T06:21:08.328002Z","iopub.status.idle":"2026-07-16T06:21:08.560424Z","shell.execute_reply.started":"2026-07-16T06:21:08.327974Z","shell.execute_reply":"2026-07-16T06:21:08.559388Z"}},"outputs":[{"name":"stdout","text":"Vocabulary size (TF-IDF): 2762\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"# Q5: Cosine similarity between prompt and option A for Row ID 1\nrow1 = df[df['id'] == 1].iloc[0]\nprompt_vec = vectorizer.transform([row1['prompt']])\noptA_vec = vectorizer.transform([row1['A']])\nsim = cosine_similarity(prompt_vec, optA_vec)[0][0]\nprint(f\"Cosine similarity (prompt vs A) for Row ID 1: {sim:.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:11.407385Z","iopub.execute_input":"2026-07-16T06:21:11.407724Z","iopub.status.idle":"2026-07-16T06:21:11.421006Z","shell.execute_reply.started":"2026-07-16T06:21:11.407686Z","shell.execute_reply":"2026-07-16T06:21:11.420217Z"}},"outputs":[{"name":"stdout","text":"Cosine similarity (prompt vs A) for Row ID 1: 0.2328\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"# Q6: % where highest cosine similarity option matches correct answer\ndef get_best_option(row):\n    prompt_vec = vectorizer.transform([str(row['prompt'])])\n    sims = {}\n    for opt in options:\n        opt_vec = vectorizer.transform([str(row[opt])])\n        sims[opt] = cosine_similarity(prompt_vec, opt_vec)[0][0]\n    return max(sims, key=sims.get)\n\ndf['predicted'] = df.apply(get_best_option, axis=1)\naccuracy = (df['predicted'] == df['answer']).mean() * 100\nprint(f\"Accuracy (highest cosine = correct): {accuracy:.1f}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:13.549759Z","iopub.execute_input":"2026-07-16T06:21:13.550048Z","iopub.status.idle":"2026-07-16T06:21:21.881620Z","shell.execute_reply.started":"2026-07-16T06:21:13.550024Z","shell.execute_reply":"2026-07-16T06:21:21.879953Z"}},"outputs":[{"name":"stdout","text":"Accuracy (highest cosine = correct): 13.7%\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"# Q7: MAP@3 if ground truth=C, prediction=[C,A,B]\ndef map_at_3(truth, preds):\n    score = 0.0\n    hits = 0\n    for i, p in enumerate(preds[:3], 1):\n        if p == truth:\n            hits += 1\n            score += hits / i\n    return score / min(1, 1)  # only 1 relevant item\n\nprint(\"MAP@3 (truth=C, preds=[C,A,B]):\", map_at_3('C', ['C','A','B']))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:33.669920Z","iopub.execute_input":"2026-07-16T06:21:33.670258Z","iopub.status.idle":"2026-07-16T06:21:33.676070Z","shell.execute_reply.started":"2026-07-16T06:21:33.670233Z","shell.execute_reply":"2026-07-16T06:21:33.675123Z"}},"outputs":[{"name":"stdout","text":"MAP@3 (truth=C, preds=[C,A,B]): 1.0\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"# Q8: MAP@3 if ground truth=B, prediction=[D,B,E]\nprint(\"MAP@3 (truth=B, preds=[D,B,E]):\", map_at_3('B', ['D','B','E']))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:39.285174Z","iopub.execute_input":"2026-07-16T06:21:39.285438Z","iopub.status.idle":"2026-07-16T06:21:39.291526Z","shell.execute_reply.started":"2026-07-16T06:21:39.285418Z","shell.execute_reply":"2026-07-16T06:21:39.289916Z"}},"outputs":[{"name":"stdout","text":"MAP@3 (truth=B, preds=[D,B,E]): 0.5\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# Q9: Majority Class Baseline MAP@3\nfreq_order = df['answer'].value_counts().index.tolist()  # sorted by frequency\ntop3 = freq_order[:3]\nprint(\"Top 3 majority classes:\", top3)\n\ndef map_at_k(truth, preds, k=3):\n    score = 0.0\n    hits = 0\n    for i, p in enumerate(preds[:k], 1):\n        if p == truth:\n            hits += 1\n            score += hits / i\n    return score\n\nscores = df['answer'].apply(lambda x: map_at_k(x, top3))\nprint(f\"Majority Class Baseline MAP@3: {scores.mean():.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:41.990966Z","iopub.execute_input":"2026-07-16T06:21:41.991270Z","iopub.status.idle":"2026-07-16T06:21:42.001429Z","shell.execute_reply.started":"2026-07-16T06:21:41.991244Z","shell.execute_reply":"2026-07-16T06:21:42.000301Z"}},"outputs":[{"name":"stdout","text":"Top 3 majority classes: ['B', 'C', 'A']\nMajority Class Baseline MAP@3: 0.4213\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"# Q10: TF-IDF Pipeline MAP@3\ndef get_top3_options(row):\n    prompt_vec = vectorizer.transform([str(row['prompt'])])\n    sims = {}\n    for opt in options:\n        opt_vec = vectorizer.transform([str(row[opt])])\n        sims[opt] = cosine_similarity(prompt_vec, opt_vec)[0][0]\n    sorted_opts = sorted(sims, key=sims.get, reverse=True)\n    return sorted_opts[:3]\n\ndf['top3_preds'] = df.apply(get_top3_options, axis=1)\ntfidf_scores = df.apply(lambda row: map_at_k(row['answer'], row['top3_preds']), axis=1)\nprint(f\"TF-IDF Pipeline MAP@3: {tfidf_scores.mean():.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-16T06:21:47.968223Z","iopub.execute_input":"2026-07-16T06:21:47.968549Z","iopub.status.idle":"2026-07-16T06:21:56.047553Z","shell.execute_reply.started":"2026-07-16T06:21:47.968524Z","shell.execute_reply":"2026-07-16T06:21:56.046527Z"}},"outputs":[{"name":"stdout","text":"TF-IDF Pipeline MAP@3: 0.3119\n","output_type":"stream"}],"execut